# syntax=docker/dockerfile:1
# Isolated integration-test service, built from immutable source instead of removed registry images.
FROM golang:1.24.2-bookworm AS build
WORKDIR /src
RUN git init . && git remote add origin https://github.com/minio/minio.git \
    && git fetch --depth 1 origin 0d7408fc9969caf07de6a8c3a84f9fbb10a6739e \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = 0d7408fc9969caf07de6a8c3a84f9fbb10a6739e
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -o /minio .
FROM debian:bookworm-slim
COPY --from=build /minio /usr/local/bin/minio
COPY --from=build /src/LICENSE /usr/share/doc/minio/LICENSE
RUN mkdir /data && chown 65532:65532 /data
USER 65532:65532
ENTRYPOINT ["minio"]
CMD ["server", "/data"]
