[Unit]
Description=RUC Makers beat
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=rucmakers
Group=rucmakers
WorkingDirectory=/srv/ruc-makers/src/app
EnvironmentFile=/srv/ruc-makers/private/site.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/srv/ruc-makers/src/app/.venv/bin/celery -A eventyay beat -l info --scheduler django_celery_beat.schedulers:DatabaseScheduler --pidfile /tmp/rucmakers-beat.pid
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/ruc-makers/src/app/eventyay/data /srv/ruc-makers/runtime

[Install]
WantedBy=multi-user.target
