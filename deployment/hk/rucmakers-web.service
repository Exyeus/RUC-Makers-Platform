[Unit]
Description=RUC Makers web
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=rucmakers
Group=rucmakers
WorkingDirectory=/srv/ruc-makers/src/app
EnvironmentFile=/srv/ruc-makers/private/site.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/srv/ruc-makers/src/app/.venv/bin/gunicorn eventyay.config.wsgi:application --bind 127.0.0.1:8000 --worker-class gthread --workers 2 --threads 4 --timeout 600 --graceful-timeout 30 --max-requests 1000 --max-requests-jitter 100 --no-control-socket
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/ruc-makers/src/app/eventyay/data /srv/ruc-makers/runtime

[Install]
WantedBy=multi-user.target
