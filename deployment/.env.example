# Copy to .env (chmod 600); fill every placeholder before starting.
APP_IMAGE=ruc-makers:REPLACE_WITH_COMMIT_SHA
REVISION=REPLACE_WITH_FULL_COMMIT_SHA
DOMAIN=makers.example.edu.cn
EVY_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
EVY_POSTGRES_DB=ruc_makers
EVY_POSTGRES_USER=ruc_makers
EVY_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
EVY_SITE_URL=https://makers.example.edu.cn
EVY_SHORT_URL=https://makers.example.edu.cn
EVY_TALK_HOSTNAME=https://makers.example.edu.cn
EVY_ALLOWED_HOSTS=["makers.example.edu.cn"]
EVY_LANGUAGE_CODE=zh-hans
EVY_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EVY_EMAIL_HOST=smtp.example.edu.cn
EVY_EMAIL_PORT=587
EVY_EMAIL_USE_TLS=true
EVY_EMAIL_HOST_USER=makers@example.edu.cn
EVY_EMAIL_HOST_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
EVY_DEFAULT_FROM_EMAIL=makers@example.edu.cn
EVY_COMPRESS_OFFLINE_REQUIRED=true
EVY_HACKATHON_STORAGE_BACKEND=local
# Use HTTPS endpoints for cloud providers. No public-read ACL or permanent URLs.
EVY_HACKATHON_S3_ENDPOINT=
EVY_HACKATHON_S3_REGION=us-east-1
EVY_HACKATHON_S3_BUCKET=
EVY_HACKATHON_S3_PREFIX=hackathon-private
EVY_HACKATHON_S3_ADDRESSING_STYLE=virtual
EVY_HACKATHON_S3_ACCESS_KEY=
EVY_HACKATHON_S3_SECRET_KEY=
