      "implementation": {
        "case": "tools/quality-browser/journeys.spec.cjs :: SUBMIT-01",
        "runner": "tools/quality-browser/run.sh",
        "server_verifier": "tools/quality-browser/verify.py",
        "environment": "local filesystem storage, isolated PostgreSQL, synthetic sessions"
